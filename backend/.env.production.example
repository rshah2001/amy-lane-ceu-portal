# Production environment template for the CEU portal backend.
# Copy real values into Render's environment (do NOT commit filled-in secrets).

ENVIRONMENT=production

# Auth — generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=__CHANGE_ME__
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Supabase Postgres. Take the URI from Supabase > Project Settings > Database,
# and change the scheme from "postgresql://" to "postgresql+psycopg://".
# Use the connection-pooler (port 6543) URI for serverless-friendly pooling.
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# CORS — the deployed Vercel frontend origin(s), comma-separated, no trailing slash.
BACKEND_CORS_ORIGINS=https://ceu-portal.vercel.app

# Used for QR codes and emailed links — the public frontend URL.
PUBLIC_FRONTEND_URL=https://ceu-portal.vercel.app

# Email (Gmail app password for the NMEDA bot account).
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=nmeda.newsletter.bot@gmail.com
SMTP_PASSWORD=__GMAIL_APP_PASSWORD__
SMTP_FROM=nmeda.newsletter.bot@gmail.com

RETENTION_YEARS=7
STORAGE_DIR=/app/storage

# --- Optional: AI survey summaries (off by default; needs Rochelle's sign-off) ---
# SURVEY_AI_ENABLED=false
# ANTHROPIC_API_KEY=
