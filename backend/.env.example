APP_NAME="CEU Compliance & Certificate Automation Portal"
ENVIRONMENT=development
# The app refuses to start if SECRET_KEY is left as this placeholder in ANY
# environment other than exactly "development" (where it is allowed but logs a
# warning). That includes staging, preview, and any typo'd value — a deploy
# signing JWTs with this world-readable key would let anyone forge an admin
# token. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=postgresql+psycopg://ceu_user:ceu_password@localhost:5432/ceu_compliance
BACKEND_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
STORAGE_DIR=storage
# Supabase Storage: set all three to store uploads + certificate PDFs in a
# Supabase bucket (local disk stays as a serving cache). Leave empty for plain
# local-disk storage (dev fallback). The bucket must be created PRIVATE — it
# holds attendee PII and certificates, served only via this API's endpoints.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
CERTIFICATE_ISSUER_NAME="Continuing Education Compliance Team"
# log | resend | smtp. Production (Render) uses resend: outbound SMTP is blocked there.
EMAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=certificates@example.com
# Resend HTTPS API (EMAIL_DELIVERY_MODE=resend): the re_... key and a verified sender.
RESEND_API_KEY=
RESEND_FROM="CEU Portal <onboarding@resend.dev>"
# Optional: contact address shown in the do-not-reply footer added to every
# outgoing email ("Questions? Contact ..."). Leave empty to omit that line.
REPLY_CONTACT_EMAIL=
RETENTION_YEARS=7
PUBLIC_FRONTEND_URL=http://127.0.0.1:8080
